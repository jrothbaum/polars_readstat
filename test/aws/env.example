# copy to env.local, then: source ./env.local
export AWS_PROFILE_NAME=prs-test
export AWS_REGION=us-east-2
export PRS_TEST_S3_BUCKET=prs-test-CHANGE-ME-$(whoami)
# short-lived credentials from the logged-in profile (re-source after ~12h)
eval "$(aws configure export-credentials --profile "$AWS_PROFILE_NAME" --format env)"
